---
import { getLegacyPage } from "../../lib/legacy-pages.mjs";
import DocumentHead from "./document/DocumentHead.astro";
import BodyOpen from "./document/BodyOpen.astro";
import SiteHeader from "./navigation/SiteHeader.astro";
import PageNavigation from "./navigation/PageNavigation.astro";
import MainContent from "./content/MainContent.astro";
import SiteFooter from "./navigation/SiteFooter.astro";
import ImageLightbox from "../media/ImageLightbox.astro";
import BodyScripts from "./document/BodyScripts.astro";

const { pagePath } = Astro.props;
const { context, metadata, modules } = getLegacyPage(pagePath);
---
<Fragment set:html={modules.beforeHead} /><DocumentHead context={context} metadata={metadata} /><Fragment set:html={modules.betweenHeadAndBody} /><BodyOpen markup={modules.bodyOpen} /><Fragment set:html={modules.beforeHeader} /><SiteHeader context={context} /><PageNavigation context={context} /><MainContent markup={modules.main} /><Fragment set:html={modules.betweenMainAndFooter} /><SiteFooter context={context} /><ImageLightbox /><BodyScripts context={context} /><Fragment set:html={modules.afterBody} />
